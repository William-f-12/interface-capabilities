{
  "name": "@icap/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Surfaces, capability artifacts, discovery, replay, policy and handoff. Deliberately has no dependency on targets/* — the system does not know the target application exists.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./web": {
      "types": "./src/surface/web.ts",
      "default": "./src/surface/web.ts"
    },
    "./anthropic": {
      "types": "./src/model/anthropic.ts",
      "default": "./src/model/anthropic.ts"
    },
    "./openai-compatible": {
      "types": "./src/model/openai-compatible.ts",
      "default": "./src/model/openai-compatible.ts"
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "ajv": "^8.20.0",
    "playwright": "^1.63.0",
    "zod": "^3.23.0"
  }
}
