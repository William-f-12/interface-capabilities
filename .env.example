# Copy to .env and fill in. Nothing in here is real; the target application is a
# local fixture with fabricated data and no connection to any real institution.

# --- Model access (needed only for a discovery run; replay never calls a model)
# Set whichever one you have. Discovery picks the provider from whichever key is
# present, or takes --provider explicitly. The loop, the compiler and the replay
# engine are identical either way — that is what the Model seam is for.
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# --- Target application credentials, resolved from config/tenants/*.json
# Those files reference these names as "env:NORTHSTAR_TELLER_USER" and never
# hold a value themselves, so a tenant profile is safe to commit. A value read
# through this path is used at sign-in and never becomes a capability input, so
# nothing writes it to a result, a trace or an artifact.
# The values below are the fixture's own demo logins, defined in
# targets/legacy-core/src/data.ts. They unlock nothing outside this repository.
NORTHSTAR_TELLER_USER=teller
NORTHSTAR_TELLER_PASSWORD=teller-pw
NORTHSTAR_SUPERVISOR_USER=supervisor
NORTHSTAR_SUPERVISOR_PASSWORD=supervisor-pw

LAKESHORE_TELLER_USER=teller
LAKESHORE_TELLER_PASSWORD=teller-pw
LAKESHORE_SUPERVISOR_USER=supervisor
LAKESHORE_SUPERVISOR_PASSWORD=supervisor-pw
