node_modules/
dist/
*.tsbuildinfo

# Credentials never enter the repo. Tenant configs name environment variables;
# the values live here and nowhere else.
.env
.env.*
!.env.example

# Playwright's own browser state can contain session cookies.
.playwright/
user-data/

# Local scratch.
tmp/
*.local.json

# Every replay writes a run under evidence/, so the default is to keep none of
# them and commit only the few worth reading. Those are force-added once
# (git add -f) and stay tracked from then on, because .gitignore has no say over
# a file git already tracks. Debugging runs therefore never show up at all.
evidence/
